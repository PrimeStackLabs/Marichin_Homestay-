# ==============================================================================
# MARICHIN HOMESTAY - SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Render sets this automatically; fallback is 5000)
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Replace with your MongoDB Atlas URI.
# IMPORTANT:
# - In MongoDB Atlas -> Network Access: Add IP Address 0.0.0.0/0 (Render IPs are dynamic)
# - If your password contains special characters like @, #, $, or %, URL-encode them.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/marichin_homestay?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT CONFIGURATION
# ------------------------------------------------------------------------------
# CRITICAL REQUIREMENTS:
# - Must be AT LEAST 32 characters long.
# - Must NOT contain the words: "secret", "marichin", or "coorg" (enforced by security guard).
JWT_SECRET=production_secure_token_signing_key_a94f8e71c9b24e65d18a
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND DOMAIN (Hostinger)
# ------------------------------------------------------------------------------
# Set this to your Hostinger frontend domain(s). Separate multiples by commas.
# Examples:
#   CLIENT_URL=https://marichinhomestay.com,https://www.marichinhomestay.com
#   SITE_URL=https://marichinhomestay.com
CLIENT_URL=https://your-hostinger-domain.com,https://www.your-hostinger-domain.com
SITE_URL=https://your-hostinger-domain.com

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN COOKIE SETTINGS (Hostinger Frontend + Render Backend)
# ------------------------------------------------------------------------------
# Because Hostinger and Render are on different domains, cross-site cookies require:
COOKIE_SAMESITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 5. INITIAL ADMIN ACCOUNT (Created automatically when running `npm run seed`)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@marichinhomestay.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# ------------------------------------------------------------------------------
# 6. CONTACT & ALERTS
# ------------------------------------------------------------------------------
WHATSAPP_NUMBER=+919591209522

# ------------------------------------------------------------------------------
# 7. EMAIL NOTIFICATIONS (SMTP / Gmail App Password)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ------------------------------------------------------------------------------
# 8. RAZORPAY PAYMENT GATEWAY (Optional - Leave blank if using Cash/UPI only)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
