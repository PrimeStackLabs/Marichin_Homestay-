# For Local Development (uses Vite dev proxy to localhost:5000):
# VITE_API_BASE_URL=/api

# For Production (Point to your live backend on Render):
# Replace "your-render-backend-name" with your actual Render service name / URL.
# Note: You can include or omit /api — the app automatically handles both formats.
VITE_API_BASE_URL=https://your-render-backend-name.onrender.com/api
